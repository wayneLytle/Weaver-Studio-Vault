## Example environment file
## Copy to .env and fill in locally (never commit real secrets)

OPENAI_API_KEY=

# Prefer referencing a file outside the repository
GOOGLE_APPLICATION_CREDENTIALS=%USERPROFILE%\secrets\gcp-weaver.json
GOOGLE_PROJECT_ID=weaver-studios
GOOGLE_LOCATION=us-east1

# Alternative regions for Alabama (if us-east1 has issues):
# GOOGLE_LOCATION=us-central1  # Iowa (current default)
# GOOGLE_LOCATION=us-south1    # Dallas, Texas

# Or embed JSON instead of a file path (uncomment and paste minimal service account JSON)
# GEMINI_SERVICE_ACCOUNT_JSON=

PORT=4101

# CORS allowlist (comma/space/semicolon separated). Defaults also include common dev ports.
# Examples: http://localhost:5173 http://127.0.0.1:5173 http://localhost:6006
# ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Validation helpers (optional):
#   git grep -I "sk-" || echo "No OpenAI-like keys found"
#   git grep -I "private_key" || echo "No private keys found"

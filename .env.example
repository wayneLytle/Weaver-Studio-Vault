# Copy this file to .env and add your API keys

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Configuration
# For local development - place key file outside repo
GOOGLE_APPLICATION_CREDENTIALS=%USERPROFILE%\secrets\gcp-weaver.json
# Alternative: Set JSON content directly (for CI/CD)
# GEMINI_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Cloud Project Settings (for Vertex AI & Gemini)
GOOGLE_PROJECT_ID=weaver-studios
GOOGLE_LOCATION=us-central1

# Server Configuration
PORT=3001

# Note: For production/CI, use Workload Identity Federation instead of JSON keys
# WIF Configuration (GitHub Actions):
# Project Number: 413404577713
# Service Account: weaverstudiovault@weaver-studios.iam.gserviceaccount.com
# Pool: projects/413404577713/locations/global/workloadIdentityPools/weaver-ci-pool